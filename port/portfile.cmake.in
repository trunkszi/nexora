vcpkg_check_linkage(ONLY_STATIC_LIBRARY)

vcpkg_from_github(
  OUT_SOURCE_PATH SOURCE_PATH
  REPO trunkszi/nexora
  REF "@GIT_COMMIT_SHA@"
  SHA512 @SHA512@
  HEAD_REF main
)

if(NOT EXISTS "${SOURCE_PATH}/LICENSE")
  message(FATAL_ERROR "nexora packaging requires the project's LICENSE file")
endif()

vcpkg_cmake_configure(
  SOURCE_PATH "${SOURCE_PATH}"
  OPTIONS
    -DNEXORA_BUILD_TESTS=OFF
    -DNEXORA_BUILD_EXAMPLES=OFF
    -DNEXORA_BUILD_BENCHES=OFF
    -DNEXORA_BUILD_TOOLS=OFF
    -DNEXORA_INSTALL_PACKAGE=ON
)
vcpkg_cmake_install()
vcpkg_cmake_config_fixup(PACKAGE_NAME nexora CONFIG_PATH lib/cmake/nexora)
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/include")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE")
file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")
