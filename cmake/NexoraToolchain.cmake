include_guard(GLOBAL)
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/tmp")
set(NEXORA_TOOLCHAIN_ROOT "$ENV{HOME}/.local/toolchain" CACHE PATH "Installed C++26 SDK root")
set(NEXORA_TOOLCHAIN_NAME "" CACHE STRING "Compiler SDK name")
function(nexora_ensure_toolchain)
  if(NOT CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR OR CMAKE_CXX_COMPILER)
    return()
  endif()
  # The vcpkg chainload toolchain owns the compiler. A cache entry set here wins over it.
  if(CMAKE_TOOLCHAIN_FILE OR VCPKG_CHAINLOAD_TOOLCHAIN_FILE)
    return()
  endif()
  if(NEXORA_TOOLCHAIN_NAME MATCHES "^clang")
    set(compiler "${NEXORA_TOOLCHAIN_ROOT}/${NEXORA_TOOLCHAIN_NAME}/bin/clang++")
    if(NEXORA_TOOLCHAIN_NAME STREQUAL "clang-musl")
      set(compiler "${NEXORA_TOOLCHAIN_ROOT}/clang-musl/bin/x86_64-unknown-linux-musl-clang++")
    endif()
  elseif(NEXORA_TOOLCHAIN_NAME MATCHES "^gcc")
    set(abi gnu)
    if(NEXORA_TOOLCHAIN_NAME STREQUAL "gcc-musl")
      set(abi musl)
    endif()
    set(compiler "${NEXORA_TOOLCHAIN_ROOT}/${NEXORA_TOOLCHAIN_NAME}/bin/x86_64-unknown-linux-${abi}-g++")
  else()
    return()
  endif()
  if(NOT EXISTS "${compiler}")
    message(FATAL_ERROR "Install the requested C++26 SDK: ${compiler}")
  endif()
  set(CMAKE_CXX_COMPILER "${compiler}" CACHE FILEPATH "C++ compiler")
endfunction()
